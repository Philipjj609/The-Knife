<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="theknife.controllers.RispondiRecensioneController"
            styleClass="main-container">

    <!-- Sticky header con pulsante indietro -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 24; -fx-background-color: -fx-surface-bg; -fx-border-color: -fx-border-light; -fx-border-width: 0 0 1 0;">
            <Button text="← Indietro" onAction="#handleAnnulla" styleClass="button,outline"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 32;">
                <VBox spacing="24" styleClass="card" style="-fx-padding: 40; -fx-max-width: 800; -fx-min-width: 500;">

                    <VBox spacing="8" alignment="CENTER">
                        <Text fx:id="titoloPaginaText" text="Rispondi alla Recensione" styleClass="subtitle"/>
                        <Text text="Rispondi in modo professionale e cortese" styleClass="body-text"/>
                    </VBox>

                    <!-- Recensione originale -->
                    <VBox spacing="12" styleClass="card" style="-fx-background-color: #f0f4f0; -fx-padding: 20;">
                        <Text text="Recensione Originale:" styleClass="heading"/>
                        <Label fx:id="recensioneInfoLabel" styleClass="body-text" style="-fx-font-weight: bold;"/>
                        <Label fx:id="recensioneTitoloLabel" styleClass="body-text" style="-fx-font-weight: bold;"/>
                        <Label fx:id="recensioneCommentoLabel" styleClass="body-text" wrapText="true"
                               style="-fx-max-width: 600;"/>
                    </VBox>

                    <VBox spacing="12">
                        <Label text="La tua risposta:" styleClass="heading"/>
                        <TextArea fx:id="rispostaArea" promptText="Scrivi una risposta professionale e cortese..."
                                 prefRowCount="8" wrapText="true"
                                 style="-fx-font-size: 15px; -fx-padding: 16; -fx-min-height: 200;"/>
                        <Label text="💡 Suggerimento: Ringrazia il cliente per il feedback e mostra come intendi migliorare il servizio."
                               styleClass="small-text" style="-fx-font-style: italic;" wrapText="true"/>
                    </VBox>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <Button fx:id="inviaRispostaButton" text="📤 Invia Risposta" onAction="#handleInviaRisposta"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 12 24; -fx-font-weight: bold;"/>
                        <Button text="Annulla" onAction="#handleAnnulla"
                                styleClass="button" style="-fx-font-size: 14px; -fx-padding: 12 20;"/>
                    </HBox>

                    <Label fx:id="errorLabel" styleClass="error" style="-fx-font-size: 14px;" wrapText="true"/>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
